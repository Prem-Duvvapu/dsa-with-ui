      "input": {
        "graph": {
          "vertices": 7,
          "edges": [
            [
              0,
              1
            ],
            [
              1,
              2
            ],
            [
              2,
              0
            ],
            [
              1,
              3
            ],
            [
              1,
              4
            ],
            [
              1,
              6
            ],
            [
              3,
              5
            ],
            [
              4,
              5
            ]
          ]
        }
      },
      "output": "[1]",
      "answerVariable": "articulation points",
      "explanation": "Deleting 1 leaves three pieces: {0, 2}, {3, 4, 5} and {6}. Every other vertex lies on a cycle or at the end of a single edge, so deleting it disconnects nothing."
    },
    {
      "input": {
        "graph": {
          "vertices": 5,
          "edges": [
            [
              0,
