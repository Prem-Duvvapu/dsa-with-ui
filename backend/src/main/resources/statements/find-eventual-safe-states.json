{
  "id": "find-eventual-safe-states",
  "statement": [
    "You are given a directed graph, made of a vertex count n (vertices numbered 0 to n − 1) and a list of edges [u, v], each an edge from u to v.",
    "A vertex is terminal when it has no outgoing edges. A vertex is safe when every path starting from it ends at a terminal vertex; in other words, no path from it can reach a cycle.",
    "Return all safe vertices in increasing order."
  ],
  "examples": [
    {
      "input": {
        "graph": {
          "vertices": 7,
          "edges": [
            [
              0,
              1
            ],
            [
              0,
              2
            ],
            [
              1,
              2
            ],
            [
              1,
              3
            ],
            [
              2,
              5
            ],
            [
              3,
              0
            ],
            [
              4,
              5
            ]
          ]
        }
      },
      "output": "[2, 4, 5, 6]",
      "answerVariable": "safeNodes",
      "explanation": "Vertices 5 and 6 are terminal, and 2 and 4 lead only to 5. Vertices 0, 1 and 3 lie on the cycle 0 → 1 → 3 → 0, so they are not safe."
    },
    {
      "input": {
        "graph": {
          "vertices": 5,
          "edges": [
            [
              0,
              1
            ],
            [
              1,
              2
            ],
            [
              2,
              0
            ],
            [
              3,
              4
            ]
          ]
        }
      },
      "output": "[3, 4]",
      "answerVariable": "safeNodes",
      "explanation": "Vertices 0, 1 and 2 form a cycle. Vertex 4 is terminal and 3 leads only to 4."
    }
  ],
  "constraints": [
    "1 ≤ n ≤ 10⁴",
    "1 ≤ number of edges ≤ 4 × 10⁴",
    "0 ≤ u, v ≤ n − 1",
    "the graph may contain self-loops"
  ],
  "sources": [
    {
      "label": "LeetCode 802",
      "url": "https://leetcode.com/problems/find-eventual-safe-states/"
    }
  ]
}
