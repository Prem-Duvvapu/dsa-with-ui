  "code" : "class ArrayStack {\n    int[] slots;\n    int top = -1;\n\n    ArrayStack(int capacity) {\n        slots = new int[capacity];\n    }\n\n    void push(int value) {\n        if (top == slots.length - 1) {\n            throw new StackOverflowError();\n        }\n        slots[++top] = value;\n    }\n\n    int pop() {\n        if (top == -1) {\n            throw new NoSuchElementException();\n        }\n        return slots[top--];\n    }\n\n    int peek() {\n        if (top == -1) {\n            throw new NoSuchElementException();\n        }\n        return slots[top];\n    }\n\n    int size() {\n        return top + 1;\n    }\n}",
