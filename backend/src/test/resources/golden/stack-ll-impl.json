  "code" : "class LinkedStack {\n    Node head = null;\n    int size = 0;\n\n    void push(int value) {\n        Node node = new Node(value);\n        node.next = head;\n        head = node;\n        size++;\n    }\n\n    int pop() {\n        if (head == null) {\n            throw new NoSuchElementException();\n        }\n        int value = head.value;\n        head = head.next;\n        size--;\n        return value;\n    }\n\n    int peek() {\n        if (head == null) {\n            throw new NoSuchElementException();\n        }\n        return head.value;\n    }\n\n    int size() {\n        return size;\n    }\n}",
