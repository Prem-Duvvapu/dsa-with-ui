  "code" : "public String longestPrefix(String s) {\n    int n = s.length();\n    int[] lps = new int[n];\n    int len = 0;\n    int i = 1;\n    while (i < n) {\n        if (s.charAt(i) == s.charAt(len)) {\n            len++;\n            lps[i] = len;\n            i++;\n        } else if (len != 0) {\n            len = lps[len - 1];\n        } else {\n            lps[i] = 0;\n            i++;\n        }\n    }\n    return s.substring(0, lps[n - 1]);\n}",
