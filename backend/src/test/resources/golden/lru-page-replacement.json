  "code" : "public int pageFaults(int[] pages, int capacity) {\n    Deque<Integer> cache = new ArrayDeque<>();\n    int faults = 0;\n    for (int page : pages) {\n        if (cache.remove(page)) {\n            cache.addFirst(page);\n            continue;\n        }\n        faults++;\n        if (cache.size() == capacity) {\n            cache.removeLast();\n        }\n        cache.addFirst(page);\n    }\n    return faults;\n}",
