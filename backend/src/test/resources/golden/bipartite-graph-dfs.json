  "code" : "public boolean isBipartite(int v, List<List<Integer>> adj) {\n    int[] color = new int[v];\n    Arrays.fill(color, -1);\n    for (int i = 0; i < v; i++) {\n        if (color[i] == -1) {\n            if (!dfs(i, 0, adj, color)) {\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nprivate boolean dfs(int node, int col, List<List<Integer>> adj, int[] color) {\n    color[node] = col;\n    for (int next : adj.get(node)) {\n        if (color[next] == -1) {\n            if (!dfs(next, 1 - col, adj, color)) {\n                return false;\n            }\n        } else if (color[next] == col) {\n            return false;\n        }\n    }\n    return true;\n}",
