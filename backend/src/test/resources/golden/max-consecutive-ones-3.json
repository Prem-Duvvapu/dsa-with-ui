  "code" : "public int longestOnes(int[] nums, int k) {\n    int left = 0, zeroes = 0, maxLen = 0;\n    for (int right = 0; right < nums.length; right++) {\n        if (nums[right] == 0) zeroes++;\n        while (zeroes > k) {\n            if (nums[left] == 0) zeroes--;\n            left++;\n        }\n        maxLen = Math.max(maxLen, right - left + 1);\n    }\n    return maxLen;\n}",
