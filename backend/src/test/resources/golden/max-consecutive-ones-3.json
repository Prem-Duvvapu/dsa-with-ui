  "code" : "class Solution {\n    public int longestOnes(int[] nums, int k) {\n        int n=nums.length;\n        int maxLen=0;\n        int left=0;\n        int right=0;\n        int zeroesCnt=0;\n\n        while (right<n) {\n            if (nums[right]==0)\n                zeroesCnt++;\n\n            if (zeroesCnt > k) {\n                if (nums[left]==0)\n                    zeroesCnt--;\n\n                left++;\n            } else {\n                int currLen=right-left+1;\n                maxLen=Math.max(maxLen,currLen);\n            }\n\n            right++;\n        }\n\n        return maxLen;\n    }\n}",
