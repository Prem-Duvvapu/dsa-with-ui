  "code" : "class MinStack {\n    Deque<Integer> stack = new ArrayDeque<>();\n    Deque<Integer> minStack = new ArrayDeque<>();\n\n    void push(int val) {\n        stack.push(val);\n        if (minStack.isEmpty() || val <= minStack.peek()) {\n            minStack.push(val);\n        } else {\n            minStack.push(minStack.peek());\n        }\n    }\n\n    void pop() {\n        stack.pop();\n        minStack.pop();\n    }\n\n    int getMin() {\n        return minStack.peek();\n    }\n}",
