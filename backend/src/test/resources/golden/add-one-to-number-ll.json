  "code" : "public ListNode addOne(ListNode head) {\n    head = reverse(head);\n    int carry = 1;\n    for (ListNode p = head; p != null && carry > 0; p = p.next) {\n        int sum = p.val + carry;\n        p.val = sum % 10;\n        carry = sum / 10;\n    }\n    if (carry > 0) {\n        append(head, new ListNode(carry));\n    }\n    head = reverse(head);\n    return head;\n}",
