  "code" : "class Solution {\n    public boolean isAnagram(String s, String t) {\n        if (s.length()!=t.length())\n            return false;\n\n        int n=s.length();\n        int[] freq=new int[26];\n\n        for (int i=0;i<n;i++) {\n            char ch=s.charAt(i);\n            freq[ch-'a']++;\n        }\n\n        for (int i=0;i<n;i++) {\n            char ch=t.charAt(i);\n            freq[ch-'a']--;\n        }\n\n        for (int i=0;i<26;i++)\n            if (freq[i]!=0)\n                return false;\n\n        return true;\n    }\n}",
