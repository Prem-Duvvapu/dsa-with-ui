  "code" : "public boolean isValid(String s) {\n    Deque<Character> stack = new ArrayDeque<>();\n    for (char c : s.toCharArray()) {\n        if (c == '(' || c == '[' || c == '{') {\n            stack.push(c);\n            continue;\n        }\n        if (stack.isEmpty() || stack.peek() != opener(c)) {\n            return false;\n        }\n        stack.pop();\n    }\n    return stack.isEmpty();\n}",
