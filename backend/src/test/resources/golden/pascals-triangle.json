  "code" : "public List<List<Integer>> generate(int numRows) {\n    List<List<Integer>> res = new ArrayList<>();\n    for (int i = 0; i < numRows; i++) {\n        List<Integer> row = new ArrayList<>();\n        for (int j = 0; j <= i; j++) {\n            if (j == 0 || j == i) {\n                row.add(1);\n            } else {\n                row.add(res.get(i - 1).get(j - 1) + res.get(i - 1).get(j));\n            }\n        }\n        res.add(row);\n    }\n    return res;\n}",
