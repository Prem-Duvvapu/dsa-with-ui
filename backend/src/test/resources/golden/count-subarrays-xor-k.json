  "code" : "public int subarraysWithXorK(int[] a, int k) {\n    int xr = 0, cnt = 0;\n    Map<Integer, Integer> map = new HashMap<>();\n    map.put(0, 1);\n\n    for (int i = 0; i < a.length; i++) {\n        xr = xr ^ a[i];\n        int x = xr ^ k;\n        if (map.containsKey(x)) {\n            cnt += map.getOrDefault(x, 0);\n        }\n        map.put(xr, map.getOrDefault(xr, 0) + 1);\n    }\n    return cnt;\n}",
