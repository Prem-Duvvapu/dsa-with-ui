  "code" : "public void buildTrie(String[] words) {\n    Node root = new Node();\n    for (String word : words) {\n        Node curr = root;\n        for (int i = 0; i < word.length(); i++) {\n            char ch = word.charAt(i);\n            if (!curr.children.containsKey(ch)) {\n                curr.children.put(ch, new Node());\n            } else {\n            }\n            curr = curr.children.get(ch);\n        }\n        curr.isEnd = true;\n    }\n}",
