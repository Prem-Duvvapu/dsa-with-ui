  "code" : "public boolean isCycle(int v, List<List<Integer>> adj) {\n    boolean[] vis = new boolean[v];\n    for (int i = 0; i < v; i++) {\n        if (!vis[i]) {\n            if (dfs(i, -1, adj, vis)) {\n                return true;\n            }\n        }\n    }\n    return false;\n}\n\nprivate boolean dfs(int node, int parent, List<List<Integer>> adj, boolean[] vis) {\n    vis[node] = true;\n    for (int next : adj.get(node)) {\n        if (!vis[next]) {\n            if (dfs(next, node, adj, vis)) {\n                return true;\n            }\n        } else if (next != parent) {\n            return true;\n        }\n    }\n    return false;\n}",
