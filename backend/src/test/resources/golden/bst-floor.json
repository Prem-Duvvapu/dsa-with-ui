  "code" : "public int floor(TreeNode root, int target) {\n    int best = NONE;\n    TreeNode curr = root;\n\n    while (curr != null) {\n        if (curr.val == target) {\n            return curr.val;         // nothing can beat the target itself\n        }\n        if (curr.val > target) {\n            curr = curr.left;        // not a candidate; record nothing\n        } else {\n            best = curr.val;         // legal floor - keep it and try to beat it\n            curr = curr.right;\n        }\n    }\n    return best;\n}",
