  "code" : "public int[] shortestPath(int v, List<List<Integer>> adj, int src) {\n    int[] dist = new int[v];\n    Arrays.fill(dist, -1);\n    dist[src] = 0;\n    Queue<Integer> queue = new LinkedList<>();\n    queue.add(src);\n\n    while (!queue.isEmpty()) {\n        int node = queue.poll();\n        for (int next : adj.get(node)) {\n            if (dist[next] == -1) {\n                dist[next] = dist[node] + 1;\n                queue.add(next);\n            }\n        }\n    }\n    return dist;\n}",
