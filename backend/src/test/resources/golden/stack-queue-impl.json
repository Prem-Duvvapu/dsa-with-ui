  "code" : "class QueueStack {\n    Deque<Integer> q = new ArrayDeque<>();\n\n    void push(int value) {\n        q.addLast(value);\n        for (int i = q.size() - 1; i > 0; i--) {\n            q.addLast(q.pollFirst());\n        }\n    }\n\n    int pop() {\n        if (q.isEmpty()) {\n            throw new NoSuchElementException();\n        }\n        return q.pollFirst();\n    }\n\n    int top() {\n        if (q.isEmpty()) {\n            throw new NoSuchElementException();\n        }\n        return q.peekFirst();\n    }\n\n    int size() {\n        return q.size();\n    }\n}",
