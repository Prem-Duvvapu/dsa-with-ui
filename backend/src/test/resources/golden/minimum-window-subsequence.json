  "code" : "public String minWindow(String s1, String s2) {\n    int m = s1.length(), n = s2.length();\n    int s1Index = 0, s2Index = 0;\n    int minLen = Integer.MAX_VALUE, startIdx = -1;\n\n    while (s1Index < m) {\n        if (s1.charAt(s1Index) == s2.charAt(s2Index)) {\n            s2Index++;\n            if (s2Index == n) {\n                int end = s1Index;\n                s2Index--;\n                while (s2Index >= 0) {\n                    if (s1.charAt(s1Index) == s2.charAt(s2Index)) s2Index--;\n                    s1Index--;\n                }\n                s1Index++;\n                s2Index = 0;\n                int len = end - s1Index + 1;\n                if (len < minLen) {\n                    minLen = len;\n                    startIdx = s1Index;\n                }\n            }\n        }\n        s1Index++;\n    }\n    return startIdx == -1 ? \"\" : s1.substring(startIdx, startIdx + minLen);\n}",
