  "code" : "public int xorInRange(int l, int r) {\n    int upToR = xorUpTo(r);\n    int upToLMinus1 = xorUpTo(l - 1);\n    int result = upToR ^ upToLMinus1;\n    return result;\n}\n\nprivate static int xorUpTo(int n) {\n    int rem = n % 4;\n    if (rem == 0) {\n        return n;\n    } else if (rem == 1) {\n        return 1;\n    } else if (rem == 2) {\n        return n + 1;\n    } else {\n        return 0;\n    }\n}",
