  "code" : "public ListNode deleteMiddle(ListNode head) {\n    ListNode slow = head, fast = head, previous = null;\n    while (fast != null && fast.next != null) {\n        previous = slow;\n        slow = slow.next;\n        fast = fast.next.next;\n    }\n    previous.next = slow.next;\n    return head;\n}",
