  "code" : "public ListNode rotateRight(ListNode head, int k) {\n    int length = 1;\n    ListNode tail = head;\n    while (tail.next != null) {\n        tail = tail.next;\n        length++;\n    }\n    k %= length;\n    tail.next = head;\n    ListNode newTail = head;\n    for (int i = 1; i < length - k; i++) newTail = newTail.next;\n    ListNode newHead = newTail.next;\n    newTail.next = null;\n    return newHead;\n}",
