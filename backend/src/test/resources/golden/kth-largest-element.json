  "code" : "class Solution {\n    public int findKthLargest(int[] nums, int k) {\n        int kle=0;\n        PriorityQueue<Integer> minHeap=new PriorityQueue<>();\n\n        for (int val: nums)\n        {\n            if (minHeap.size()<=k)\n                minHeap.add(val);\n\n            if (minHeap.size()>k)\n                minHeap.poll();\n        }\n\n        return minHeap.peek();\n    }\n}",
