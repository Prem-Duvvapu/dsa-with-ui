  "code" : "public List<Integer> divisors(int n) {\n    List<Integer> divs = new ArrayList<>();\n    for (int i = 1; (long) i * i <= n; i++) {\n        if (n % i == 0) {\n            divs.add(i);\n            if (i != n / i) {\n                divs.add(n / i);\n            }\n        }\n    }\n    Collections.sort(divs);\n    return divs;\n}",
