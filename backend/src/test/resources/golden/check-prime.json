  "code" : "public boolean isPrime(int n) {\n    if (n <= 1) return false;\n    int count = 0;\n    for (int i = 1; i * i <= n; i++) {\n        if (n % i == 0) {\n            count++;\n            if ((n / i) != i) count++;\n        } else {\n            continue;\n        }\n    }\n    return count == 2;\n}",
