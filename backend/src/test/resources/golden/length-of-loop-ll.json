  "code" : "public int loopLength(ListNode head) {\n    ListNode slow = head, fast = head;\n    do {\n        slow = slow.next;\n        fast = fast.next.next;\n    } while (slow != fast);\n    int length = 1;\n    for (ListNode p = slow.next; p != slow; p = p.next) {\n        length++;\n    }\n    return length;\n}",
