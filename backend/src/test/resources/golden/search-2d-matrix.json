  "code" : "public boolean searchMatrix(int[][] matrix, int target) {\n    int rows = matrix.length, cols = matrix[0].length;\n    int low = 0, high = rows * cols - 1;\n    while (low <= high) {\n        int mid = (low + high) / 2;\n        int r = mid / cols, c = mid % cols;\n        int val = matrix[r][c];\n        if (val == target) {\n            return true;\n        } else if (val < target) {\n            low = mid + 1;\n        } else {\n            high = mid - 1;\n        }\n    }\n    return false;\n}",
