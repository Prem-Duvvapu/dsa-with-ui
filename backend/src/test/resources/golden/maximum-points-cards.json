  "code" : "class Solution {\n    public int maxScore(int[] cardPoints, int k) {\n        int n = cardPoints.length;\n        int maxSum = 0;\n        int currSum = 0;\n\n        for (int i=0;i<k;i++) {\n            currSum += cardPoints[i];\n        }\n\n        maxSum = currSum;\n\n        int i = 0;\n        int j = k-1;\n\n        while (j>=0) {\n            currSum -= cardPoints[j];\n            j--;\n            i--;\n\n            i = (i+n)%n;\n            currSum += cardPoints[i];\n            maxSum = Math.max(currSum, maxSum);\n        }\n\n        return maxSum;\n    }\n}",
