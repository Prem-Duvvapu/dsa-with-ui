  "code" : "public boolean checkValidString(String s) {\n    int low = 0, high = 0;\n    for (int i = 0; i < s.length(); i++) {\n        char ch = s.charAt(i);\n        if (ch == '(') {\n            low++; high++;\n        } else if (ch == ')') {\n            low = Math.max(0, low - 1); high--;\n        } else {\n            low = Math.max(0, low - 1); high++;\n        }\n        if (high < 0) {\n            return false;\n        }\n    }\n    return low == 0;\n}",
