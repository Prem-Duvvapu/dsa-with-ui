  "code" : "public int maxLen(int[] arr) {\n    Map<Integer, Integer> map = new HashMap<>();\n    int maxi = 0, sum = 0;\n\n    for (int i = 0; i < arr.length; i++) {\n        sum += arr[i];\n        if (sum == 0) {\n            maxi = i + 1;\n        } else {\n            if (map.containsKey(sum)) {\n                maxi = Math.max(maxi, i - map.get(sum));\n            } else {\n                map.put(sum, i);\n            }\n        }\n    }\n    return maxi;\n}",
