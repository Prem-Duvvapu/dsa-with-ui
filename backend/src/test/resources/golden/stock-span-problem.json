  "code" : "public int[] stockSpan(int[] prices) {\n    int n = prices.length;\n    int[] span = new int[n];\n    Deque<Integer> stack = new ArrayDeque<>();\n    for (int i = 0; i < n; i++) {\n        while (!stack.isEmpty() && prices[stack.peek()] <= prices[i]) {\n            stack.pop();\n        }\n        span[i] = stack.isEmpty() ? i + 1 : i - stack.peek();\n        stack.push(i);\n    }\n    return span;\n}",
