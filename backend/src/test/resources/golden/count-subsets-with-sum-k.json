  "code" : "public int countSubsetsWithSumK(int[] nums, int k) {\n    int n = nums.length;\n    int[][] dp = new int[n + 1][k + 1];\n    dp[0][0] = 1;\n    for (int i = 1; i <= n; i++) {\n        for (int s = 0; s <= k; s++) {\n            int skip = dp[i - 1][s];\n            int take = (s >= nums[i - 1]) ? dp[i - 1][s - nums[i - 1]] : 0;\n            dp[i][s] = skip + take;\n        }\n    }\n    return dp[n][k];\n}",
