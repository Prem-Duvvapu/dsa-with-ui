  "code" : "public String reverseEveryWord(String s) {\n    char[] chars = s.toCharArray();\n    int start = 0;\n    while (start < chars.length) {\n        int end = start;\n        while (end < chars.length && chars[end] != ' ') end++;\n        reverse(chars, start, end - 1);\n        start = end + 1;\n    }\n    return new String(chars);\n}",
