  "code" : "public List<Integer> bfs(int v, List<List<Integer>> adj, int start) {\n    boolean[] seen = new boolean[v];\n    Queue<Integer> queue = new LinkedList<>();\n    queue.add(start);\n    seen[start] = true;\n    while (!queue.isEmpty()) {\n        int node = queue.poll();\n        for (int next : adj.get(node)) {\n            if (!seen[next]) {\n                seen[next] = true;\n                queue.add(next);\n            }\n        }\n    }\n    return order;\n}",
