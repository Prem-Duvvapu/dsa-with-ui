  "code" : "public int minDays(int[] bloomDay, int m, int k) {\n    long need = (long) m * k;\n    if (need > bloomDay.length) {\n        return -1;\n    }\n    int low = min(bloomDay), high = max(bloomDay), ans = -1;\n    while (low <= high) {\n        int mid = (low + high) / 2;\n        int bouquets = 0, run = 0;\n        for (int day : bloomDay) {\n            if (day <= mid) {\n                run++;\n                if (run == k) { bouquets++; run = 0; }\n            } else {\n                run = 0;\n            }\n        }\n        if (bouquets >= m) {\n            ans = mid;\n            high = mid - 1;\n        } else {\n            low = mid + 1;\n        }\n    }\n    return ans;\n}",
