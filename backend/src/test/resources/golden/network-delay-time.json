  "code" : "public int networkDelayTime(int n, List<List<int[]>> adj, int source) {\n    int[] time = new int[n];\n    Arrays.fill(time, Integer.MAX_VALUE);\n    time[source] = 0;\n    PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> a[1] - b[1]);\n    pq.add(new int[]{source, 0});\n\n    while (!pq.isEmpty()) {\n        int[] top = pq.poll();\n        int node = top[0], t = top[1];\n        if (t > time[node]) {\n            continue;\n        }\n        for (int[] link : adj.get(node)) {\n            int next = link[0], travel = link[1];\n            if (t + travel < time[next]) {\n                time[next] = t + travel;\n                pq.add(new int[]{next, time[next]});\n            } else {\n                continue;\n            }\n        }\n    }\n\n    int slowest = 0;\n    for (int t : time) {\n        if (t == Integer.MAX_VALUE) return -1;\n        slowest = Math.max(slowest, t);\n    }\n    return slowest;\n}",
