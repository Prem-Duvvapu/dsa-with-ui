  "code" : "public int change(int[] coins, int amount) {\n    int n = coins.length;\n    int[][] dp = new int[n + 1][amount + 1];\n    for (int i = 0; i <= n; i++) {\n        dp[i][0] = 1;\n    }\n    for (int x = 1; x <= amount; x++) {\n        dp[0][x] = 0;\n    }\n    for (int i = 1; i <= n; i++) {\n        for (int x = 1; x <= amount; x++) {\n            int without = dp[i - 1][x];\n            if (x < coins[i - 1]) {\n                dp[i][x] = without;\n            } else {\n                int withAtLeastOne = dp[i][x - coins[i - 1]];\n                dp[i][x] = without + withAtLeastOne;\n            }\n        }\n    }\n    return dp[n][amount];\n}",
