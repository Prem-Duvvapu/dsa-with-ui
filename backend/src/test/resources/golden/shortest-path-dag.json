  "code" : "public int[] shortestPath(int v, List<List<int[]>> adj, int src) {\n    boolean[] vis = new boolean[v];\n    Deque<Integer> order = new ArrayDeque<>();\n    for (int i = 0; i < v; i++) {\n        if (!vis[i]) dfs(i, adj, vis, order);\n    }\n\n    int[] dist = new int[v];\n    Arrays.fill(dist, Integer.MAX_VALUE);\n    dist[src] = 0;\n\n    while (!order.isEmpty()) {\n        int node = order.pop();\n        if (dist[node] == Integer.MAX_VALUE) {\n            continue;\n        }\n        for (int[] edge : adj.get(node)) {\n            int next = edge[0], weight = edge[1];\n            if (dist[node] + weight < dist[next]) {\n                dist[next] = dist[node] + weight;\n            }\n        }\n    }\n    return dist;\n}\n\nprivate void dfs(int node, List<List<int[]>> adj, boolean[] vis, Deque<Integer> order) {\n    vis[node] = true;\n    for (int[] edge : adj.get(node)) {\n        if (!vis[edge[0]]) dfs(edge[0], adj, vis, order);\n    }\n    order.push(node);\n}",
