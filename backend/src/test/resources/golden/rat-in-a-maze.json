  "code" : "public List<String> findPath(int[][] maze) {\n    int n = maze.length;\n    List<String> paths = new ArrayList<>();\n    if (maze[0][0] == 1) {\n        visited[0][0] = true;\n        explore(0, 0, maze, n, \"\", paths);\n    }\n    return paths;\n}\n\nprivate void explore(int r, int c, int[][] maze, int n, String path, List<String> paths) {\n    if (r == n - 1 && c == n - 1) {\n        paths.add(path);\n        return;\n    }\n    int[][] dirs = {{1,0,'D'}, {0,-1,'L'}, {0,1,'R'}, {-1,0,'U'}};\n    for (int[] d : dirs) {\n        int nr = r + d[0], nc = c + d[1];\n        if (nr < 0 || nr >= n || nc < 0 || nc >= n\n                || maze[nr][nc] == 0 || visited[nr][nc]) {\n            continue;\n        }\n        visited[nr][nc] = true;\n        explore(nr, nc, maze, n, path + (char) d[2], paths);\n        visited[nr][nc] = false;\n    }\n}",
