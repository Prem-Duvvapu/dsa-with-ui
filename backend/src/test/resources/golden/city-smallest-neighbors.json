  "code" : "public int findTheCity(int n, int[][] edges, int distanceThreshold) {\n    int[][] dist = new int[n][n];\n    for (int[] row : dist) Arrays.fill(row, INF);\n    for (int i = 0; i < n; i++) dist[i][i] = 0;\n    for (int[] e : edges) {\n        dist[e[0]][e[1]] = Math.min(dist[e[0]][e[1]], e[2]);\n        dist[e[1]][e[0]] = Math.min(dist[e[1]][e[0]], e[2]);\n    }\n\n    for (int k = 0; k < n; k++) {\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (dist[i][k] + dist[k][j] < dist[i][j]) {\n                    dist[i][j] = dist[i][k] + dist[k][j];\n                }\n            }\n        }\n    }\n\n    int best = -1, fewest = n + 1;\n    for (int city = 0; city < n; city++) {\n        int reachable = 0;\n        for (int j = 0; j < n; j++) {\n            if (j != city && dist[city][j] <= distanceThreshold) reachable++;\n        }\n        if (reachable <= fewest) {\n            fewest = reachable;\n            best = city;\n        }\n    }\n    return best;\n}",
