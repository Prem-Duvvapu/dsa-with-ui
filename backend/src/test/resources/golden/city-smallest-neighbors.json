  "code" : "class Solution {\n    public int findTheCity(int n, int[][] edges, int distanceThreshold) {\n        int res = -1;\n        int minCitiesCnt = n+1;\n        int[][] dist = new int[n][n];\n\n        for (int i=0;i<n;i++) {\n            for (int j=0;j<n;j++) {\n                if (i != j)\n                    dist[i][j] = (int)1e8;\n            }\n        }\n\n        for (int[] e: edges) {\n            int u = e[0];\n            int v = e[1];\n            int wt = e[2];\n\n            dist[u][v] = wt;\n            dist[v][u] = wt;\n        }\n\n        for (int k=0;k<n;k++) {\n            for (int i=0;i<n;i++) {\n                for (int j=0;j<n;j++) {\n                    dist[i][j] = Math.min(dist[i][j], dist[i][k] + dist[k][j]);\n                }\n            }\n        }\n\n        for (int i=0;i<n;i++) {\n            int currCitiesCnt = 0;\n            for (int j=0;j<n;j++) {\n                if (i != j && dist[i][j] <= distanceThreshold) {\n                    currCitiesCnt++;\n                }\n            }\n\n            if (currCitiesCnt <= minCitiesCnt) {\n                minCitiesCnt = currCitiesCnt;\n                res = i;\n            }\n        }\n\n        return res;\n    }\n}",
