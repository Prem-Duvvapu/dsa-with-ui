  "code" : "public void shortestDistance(int[][] matrix) {\n    int n = matrix.length;\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < n; j++) {\n            if (matrix[i][j] == -1) matrix[i][j] = INF;\n            if (i == j) matrix[i][j] = 0;\n        }\n    }\n\n    for (int k = 0; k < n; k++) {\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (i == j) continue;\n                if (matrix[i][k] == INF || matrix[k][j] == INF) continue;\n                if (matrix[i][k] + matrix[k][j] < matrix[i][j]) {\n                    matrix[i][j] = matrix[i][k] + matrix[k][j];\n                } else {\n                    continue;\n                }\n            }\n        }\n    }\n\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < n; j++) {\n            if (matrix[i][j] == INF) matrix[i][j] = -1;\n        }\n    }\n}",
