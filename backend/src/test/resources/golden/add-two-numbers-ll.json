  "code" : "public ListNode addTwoNumbers(ListNode a, ListNode b) {\n    ListNode dummy = new ListNode(0), tail = dummy;\n    int carry = 0;\n    while (a != null || b != null || carry != 0) {\n        int sum = value(a) + value(b) + carry;\n        tail.next = new ListNode(sum % 10);\n        tail = tail.next;\n        carry = sum / 10;\n    }\n    return dummy.next;\n}",
