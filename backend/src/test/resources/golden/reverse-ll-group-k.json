  "code" : "public ListNode reverseKGroup(ListNode head, int k) {\n    ListNode node = head;\n    List<Integer> result = new ArrayList<>();\n\n    while (node != null) {\n        int count = 0;\n        ListNode check = node;\n        while (check != null && count < k) {\n            check = check.next;\n            count++;\n        }\n\n        if (count == k) {\n            ListNode prev = check;\n            ListNode curr = node;\n            for (int i = 0; i < k; i++) {\n                ListNode next = curr.next;\n                curr.next = prev;\n                prev = curr;\n                curr = next;\n            }\n            node = check;\n        } else {\n            node = null;\n        }\n    }\n    return head;\n}",
