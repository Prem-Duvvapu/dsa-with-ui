  "code" : "public List<Integer> boundary(TreeNode root) {\n    List<Integer> out = new ArrayList<>();\n    if (root == null) return out;\n    if (!isLeaf(root)) {\n        out.add(root.val);\n    }\n\n    TreeNode curr = root.left;\n    while (curr != null) {\n        if (!isLeaf(curr)) {\n            out.add(curr.val);\n        } else {\n            ;                      // the leaf pass owns it\n        }\n        curr = curr.left != null ? curr.left : curr.right;\n    }\n\n    addLeaves(root, out);\n\n    List<Integer> rightSide = new ArrayList<>();\n    curr = root.right;\n    while (curr != null) {\n        if (!isLeaf(curr)) {\n            rightSide.add(curr.val);\n        } else {\n            ;                      // the leaf pass owns it\n        }\n        curr = curr.right != null ? curr.right : curr.left;\n    }\n    Collections.reverse(rightSide);\n    out.addAll(rightSide);\n\n    return out;\n}\n\nprivate void addLeaves(TreeNode node, List<Integer> out) {\n    if (node == null) return;\n    if (isLeaf(node)) {\n        out.add(node.val);\n        return;\n    }\n    addLeaves(node.left, out);\n    addLeaves(node.right, out);\n}",
