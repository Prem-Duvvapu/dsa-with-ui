  "code" : "class Solution {\n    public int numberOfSubstrings(String s) {\n        int n=s.length();\n        int[] lastSeen=new int[3];\n        Arrays.fill(lastSeen,-1);\n        int res=0;\n\n        for (int i=0;i<n;i++) {\n            char ch=s.charAt(i);\n            lastSeen[ch-'a']=i;\n\n            if (lastSeen[0]!=-1 && lastSeen[1]!=-1 && lastSeen[2]!=-1) {\n                int startIndex=Math.min(lastSeen[0],Math.min(lastSeen[1],lastSeen[2]));\n                res+=(1+startIndex);\n            }\n        }\n\n        return res;\n    }\n}",
