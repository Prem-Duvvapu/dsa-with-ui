  "code" : "public boolean isCycle(int v, List<List<Integer>> adj) {\n    boolean[] vis = new boolean[v];\n    for (int i = 0; i < v; i++) {\n        if (!vis[i]) {\n            if (checkForCycle(i, adj, vis)) {\n                return true;\n            }\n        }\n    }\n    return false;\n}\n\nprivate boolean checkForCycle(int src, List<List<Integer>> adj, boolean[] vis) {\n    vis[src] = true;\n    Queue<int[]> queue = new LinkedList<>();\n    queue.add(new int[]{src, -1});\n\n    while (!queue.isEmpty()) {\n        int[] pair = queue.poll();\n        int node = pair[0], parent = pair[1];\n\n        for (int next : adj.get(node)) {\n            if (!vis[next]) {\n                vis[next] = true;\n                queue.add(new int[]{next, node});\n            } else if (next != parent) {\n                return true;\n            }\n        }\n    }\n    return false;\n}",
