  "code" : "public double fractionalKnapsack(int[] values, int[] weights, int capacity) {\n    Integer[] order = sortByRatioDescending(values, weights);\n    double totalValue = 0;\n    int remaining = capacity;\n    for (int idx : order) {\n        if (remaining <= 0) {\n            continue;\n        }\n        if (weights[idx] <= remaining) {\n            totalValue += values[idx];\n            remaining -= weights[idx];\n        } else {\n            double fraction = (double) remaining / weights[idx];\n            totalValue += fraction * values[idx];\n            remaining = 0;\n        }\n    }\n    return totalValue;\n}",
