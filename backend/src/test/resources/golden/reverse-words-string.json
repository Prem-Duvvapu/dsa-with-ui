  "code" : "class Solution {\n    public String reverseWords(String s) {\n        String[] words=s.trim().split(\"\\\\s+\");\n        StringBuilder res=new StringBuilder();\n\n        for (int i=words.length-1;i>=0;i--) {\n            res.append(words[i]);\n            if (i!=0)\n                res.append(\" \");\n        }\n\n        return res.toString();\n    }\n}",
