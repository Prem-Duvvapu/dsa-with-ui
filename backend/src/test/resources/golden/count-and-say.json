  "code" : "class Solution {\n    public String countAndSay(int n) {\n        if (n==1)\n            return \"1\";\n\n        String prev=countAndSay(n-1);\n        StringBuilder curr=new StringBuilder();\n        int i=0;\n\n        while (i<prev.length()) {\n            char ch=prev.charAt(i);\n            int j=i+1;\n\n            while (j<prev.length() && prev.charAt(j)==ch)\n                j++;\n\n            int cnt=j-i;\n            curr.append(cnt).append(ch);\n            i=j;\n        }\n\n        return curr.toString();\n    }\n}",
