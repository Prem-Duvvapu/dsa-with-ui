  "code" : "public ListNode deleteAll(ListNode head, int key) {\n    ListNode current = head;\n    while (current != null) {\n        ListNode next = current.next;\n        if (current.val == key) {\n            unlink(current);\n            if (current == head) head = next;\n        }\n        current = next;\n    }\n    return head;\n}",
