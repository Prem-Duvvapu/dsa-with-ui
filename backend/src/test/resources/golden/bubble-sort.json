  "code" : "public void bubbleSort(int[] arr, int n) {\n    for (int i = n - 1; i >= 0; i--) {\n        boolean didSwap = false;\n        for (int j = 0; j <= i - 1; j++) {\n            if (arr[j] > arr[j + 1]) {\n                int temp = arr[j];\n                arr[j] = arr[j + 1];\n                arr[j + 1] = temp;\n                didSwap = true;\n            }\n        }\n        if (!didSwap) {\n            break;\n        }\n    }\n}",
