  "code" : "public void sortColors(int[] nums) {\n    int low = 0, mid = 0, high = nums.length - 1;\n    while (mid <= high) {\n        if (nums[mid] == 0) {\n            int temp = nums[low]; nums[low] = nums[mid]; nums[mid] = temp;\n            low++; mid++;\n        } else if (nums[mid] == 1) {\n            mid++;\n        } else {\n            int temp = nums[mid]; nums[mid] = nums[high]; nums[high] = temp;\n            high--;\n        }\n    }\n}",
