  "code" : "class Solution {\n    public boolean isIsomorphic(String s, String t) {\n        int n=s.length();\n\n        int[] sTot=new int[256];\n        int[] tTos=new int[256];\n\n        Arrays.fill(sTot,-1);\n        Arrays.fill(tTos,-1);\n\n        for (int i=0;i<n;i++) {\n            char sChar=s.charAt(i);\n            char tChar=t.charAt(i);\n\n            //s to t checking\n            if (sTot[sChar]!=-1 && sTot[sChar]!=tChar)\n                return false;\n            else\n                sTot[sChar]=tChar;\n\n            //t to s checking\n            if (tTos[tChar]!=-1 && tTos[tChar]!=sChar)\n                return false;\n            else\n                tTos[tChar]=sChar;\n        }\n\n        return true;\n    }\n}",
