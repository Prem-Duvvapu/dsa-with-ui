  "code" : "class Solution {\n    public int numberOfSubarrays(int[] nums, int k) {\n        int n=nums.length;\n        int[] arr=new int[n];\n\n        for (int i=0;i<n;i++)\n            arr[i]=nums[i]%2;\n\n        int res=solve(arr,k)-solve(arr,k-1);\n        return res;\n    }\n\n    private int solve(int[] nums,int k) {\n        int left=0;\n        int right=0;\n        int resCnt=0;\n        int sum=0;\n\n        while (right < nums.length) {\n            sum+=nums[right];\n\n            while (sum > k) {\n                sum-=nums[left];\n                left++;\n            }\n\n            resCnt+=(right-left+1);\n            right++;\n        }\n\n        return resCnt;\n    }\n}",
