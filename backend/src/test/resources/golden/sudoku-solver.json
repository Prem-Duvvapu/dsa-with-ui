  "code" : "public boolean solveSudoku(int[][] board) {\n    return solve(board);\n}\n\nprivate boolean solve(int[][] board) {\n    int[] empty = findEmpty(board);\n    if (empty == null) {\n        return true;\n    }\n    int row = empty[0], col = empty[1];\n    for (int digit = 1; digit <= 9; digit++) {\n        if (!isValid(board, row, col, digit)) {\n            continue;\n        }\n        board[row][col] = digit;\n        if (solve(board)) {\n            return true;\n        }\n        board[row][col] = 0;\n    }\n    return false;\n}",
