  "code" : "public int findPages(int[] pages, int m) {\n    int low = max(pages), high = sum(pages), ans = high;\n    while (low <= high) {\n        int mid = (low + high) / 2;\n        if (countStudents(pages, mid) <= m) {\n            ans = mid;\n            high = mid - 1;\n        } else {\n            low = mid + 1;\n        }\n    }\n    return ans;\n}\n\nprivate int countStudents(int[] pages, int cap) {\n    int students = 1, pageSum = 0;\n    for (int p : pages) {\n        if (pageSum + p > cap) {\n            students++;\n            pageSum = p;\n        } else {\n            pageSum += p;\n        }\n    }\n    return students;\n}",
