  "code" : "class Solution {\n    public String largestOddNumber(String num) {\n        int n=num.length();\n\n        for (int i=n-1;i>=0;i--)\n        {\n            char curr=num.charAt(i);\n            if ((curr-'0')%2==1)\n                return num.substring(0,i+1);\n        }\n\n        return \"\";\n    }\n}",
