  "code" : "public List<Integer> morrisInorder(TreeNode root) {\n    List<Integer> result = new ArrayList<>();\n    TreeNode curr = root;\n\n    while (curr != null) {\n        if (curr.left == null) {\n            result.add(curr.val);\n            curr = curr.right;\n        } else {\n            TreeNode pred = curr.left;\n            while (pred.right != null && pred.right != curr) {\n                pred = pred.right;\n            }\n            if (pred.right == null) {\n                pred.right = curr;\n                curr = curr.left;\n            } else {\n                pred.right = null;\n                result.add(curr.val);\n                curr = curr.right;\n            }\n        }\n    }\n    return result;\n}",
