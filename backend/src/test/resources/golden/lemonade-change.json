  "code" : "public boolean lemonadeChange(int[] bills) {\n    int five = 0, ten = 0;\n    boolean ok = true;\n    for (int bill : bills) {\n        if (!ok) continue;\n        if (bill == 5) {\n            five++;\n        } else if (bill == 10) {\n            if (five >= 1) { five--; ten++; }\n            else { ok = false; }\n        } else {\n            if (ten >= 1 && five >= 1) { ten--; five--; }\n            else if (five >= 3) { five -= 3; }\n            else { ok = false; }\n        }\n    }\n    return ok;\n}",
