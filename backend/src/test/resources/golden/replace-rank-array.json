  "code" : "class Solution {\n    public int[] arrayRankTransform(int[] arr) {\n        int n=arr.length;\n        int[][] sortedArr=new int[n][2];\n        int[] res=new int[n];\n\n        if (n==0)\n            return res;\n\n        for (int i=0;i<n;i++) {\n            sortedArr[i][0]=arr[i];\n            sortedArr[i][1]=i;\n        }\n\n        Arrays.sort(sortedArr, (x,y) -> Integer.compare(x[0],y[0]));\n\n        int rank=1;\n        res[sortedArr[0][1]]=rank;\n\n        for (int i=1;i<n;i++) {\n            if (sortedArr[i][0]==sortedArr[i-1][0])\n                res[sortedArr[i][1]]=rank;\n            else\n                res[sortedArr[i][1]]=++rank;\n        }\n\n        return res;\n    }\n}",
