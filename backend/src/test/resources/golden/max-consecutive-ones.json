  "code" : "public int findMaxConsecutiveOnes(int[] nums) {\n    int best = 0, run = 0;\n    for (int i = 0; i < nums.length; i++) {\n        if (nums[i] == 1) {\n            run++;\n            if (run > best) best = run;\n        } else {\n            run = 0;\n        }\n    }\n    return best;\n}",
