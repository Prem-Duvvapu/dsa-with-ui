  "code" : "public int splitArray(int[] nums, int m) {\n    int max = 0, sum = 0;\n    for (int x : nums) { max = Math.max(max, x); sum += x; }\n    int low = max, high = sum, ans = high;\n\n    while (low <= high) {\n        int mid = (low + high) / 2;\n        int splits = 1, current = 0;\n        for (int x : nums) {\n            if (current + x > mid) {\n                splits++;\n                current = x;\n            } else {\n                current += x;\n            }\n        }\n        if (splits <= m) {\n            ans = mid;\n            high = mid - 1;\n        } else {\n            low = mid + 1;\n        }\n    }\n    return ans;\n}",
