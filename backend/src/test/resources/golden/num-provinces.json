  "code" : "public int findCircleNum(int[][] isConnected) {\n    int n = isConnected.length;\n    boolean[] visited = new boolean[n];\n    int provinces = 0;\n\n    for (int i = 0; i < n; i++) {\n        if (visited[i]) {\n            continue;\n        }\n        provinces++;\n        Queue<Integer> queue = new LinkedList<>();\n        queue.add(i);\n        visited[i] = true;\n\n        while (!queue.isEmpty()) {\n            int city = queue.poll();\n            for (int j = 0; j < n; j++) {\n                if (isConnected[city][j] == 0) {\n                    continue;\n                }\n                if (visited[j]) {\n                    continue;\n                }\n                visited[j] = true;\n                queue.add(j);\n            }\n        }\n    }\n    return provinces;\n}",
