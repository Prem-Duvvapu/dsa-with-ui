  "code" : "public TreeNode insertIntoBST(TreeNode root, int val) {\n    TreeNode curr = root;\n    while (true) {\n        if (val < curr.val) {\n            if (curr.left == null) {\n                curr.left = new TreeNode(val);\n                break;\n            }\n            curr = curr.left;\n        } else {\n            if (curr.right == null) {\n                curr.right = new TreeNode(val);\n                break;\n            }\n            curr = curr.right;\n        }\n    }\n    return root;\n}",
