  "code" : "public int romanToInt(String roman) {\n    int total = 0, previous = 0;\n    for (int i = roman.length() - 1; i >= 0; i--) {\n        int value = valueOf(roman.charAt(i));\n        total += value < previous ? -value : value;\n        previous = Math.max(previous, value);\n    }\n    return total;\n}",
