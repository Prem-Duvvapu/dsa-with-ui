  "code" : "public int maxMeetings(int[] start, int[] end) {\n    int n = start.length;\n    int[][] meetings = new int[n][2];\n    for (int i = 0; i < n; i++) {\n        meetings[i][0] = start[i];\n        meetings[i][1] = end[i];\n    }\n    Arrays.sort(meetings, (a, b) -> a[1] - b[1]);\n    int count = 0, lastEnd = -1;\n    for (int[] m : meetings) {\n        if (m[0] > lastEnd) {\n            count++;\n            lastEnd = m[1];\n        } else {\n            continue;\n        }\n    }\n    return count;\n}",
