  "code" : "// Changed from your submission: it kept every distinct value in a max-heap, O(n log n). A\n// min-heap by frequency trimmed to k keeps only the k most frequent - O(n log k).\nclass Solution {\n    public int[] topKFrequent(int[] nums, int k) {\n        int[] res=new int[k];\n        Map<Integer,Integer> map=new HashMap<>();\n\n        for (int val: nums)\n            map.put(val,map.getOrDefault(val,0)+1);\n\n        PriorityQueue<Integer> pq=new PriorityQueue<>((x,y) -> Integer.compare(map.get(x),map.get(y)));\n        for (int val: map.keySet()) {\n            pq.add(val);\n            if (pq.size()>k)\n                pq.poll();\n        }\n\n        int pos=k-1;\n        while (pos>=0) {\n            res[pos]=pq.poll();\n            pos--;\n        }\n\n        return res;\n    }\n}",
