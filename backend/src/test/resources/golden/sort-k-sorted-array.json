  "code" : "public int[] sortKSorted(int[] values, int k) {\n    PriorityQueue<Integer> heap = new PriorityQueue<>();\n    int write = 0;\n    for (int value : values) {\n        heap.offer(value);\n        if (heap.size() > k) {\n            values[write++] = heap.poll();\n        }\n    }\n    while (!heap.isEmpty()) {\n        values[write++] = heap.poll();\n    }\n    return values;\n}",
