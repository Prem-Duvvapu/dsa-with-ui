  "code" : "public void merge(int[] arr1, int[] arr2, int n, int m) {\n    int len = n + m;\n    int gap = (len / 2) + (len % 2);\n\n    while (gap > 0) {\n        int left = 0, right = left + gap;\n        while (right < len) {\n            int leftVal = get(arr1, arr2, n, left);\n            int rightVal = get(arr1, arr2, n, right);\n            if (leftVal > rightVal) {\n                set(arr1, arr2, n, left, rightVal);\n                set(arr1, arr2, n, right, leftVal);\n            } else {\n            }\n            left++; right++;\n        }\n        if (gap == 1) break;\n        gap = (gap / 2) + (gap % 2);\n    }\n}",
