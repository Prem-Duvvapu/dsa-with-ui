  "code" : "public int countCompleteTree(TreeNode root) {\n    int total = countNodes(root);\n    return total;\n}\n\nprivate int countNodes(TreeNode node) {\n    if (node == null) {\n        return 0;\n    }\n    int left = leftSpine(node);\n    int right = rightSpine(node);\n\n    if (left == right) {\n        return (1 << left) - 1;    // counted without visiting one of them\n    }\n    return 1 + countNodes(node.left) + countNodes(node.right);\n}\n\nprivate int leftSpine(TreeNode node) {\n    int h = 0;\n    while (node != null) {\n        h++;\n        node = node.left;\n    }\n    return h;\n}\n\nprivate int rightSpine(TreeNode node) {\n    int h = 0;\n    while (node != null) {\n        h++;\n        node = node.right;\n    }\n    return h;\n}",
