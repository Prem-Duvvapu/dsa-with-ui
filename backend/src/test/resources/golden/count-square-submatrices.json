  "code" : "public int countSquares(int[][] matrix) {\n    int total = 0;\n    for (int r = 0; r < matrix.length; r++) {\n        for (int c = 0; c < matrix[0].length; c++) {\n            if (matrix[r][c] == 1 && r > 0 && c > 0) {\n                matrix[r][c] = 1 + Math.min(matrix[r][c - 1],\n                                    Math.min(matrix[r - 1][c], matrix[r - 1][c - 1]));\n            }\n            total += matrix[r][c];\n        }\n    }\n    return total;\n}",
