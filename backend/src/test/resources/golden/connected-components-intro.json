  "code" : "public int components(int vertices, List<List<Integer>> adj) {\n    boolean[] seen = new boolean[vertices];\n    int count = 0;\n    for (int node = 0; node < vertices; node++) {\n        if (seen[node]) {\n            continue;\n        }\n        count++;\n        dfs(node, adj, seen);\n    }\n    return count;\n}\n\nprivate void dfs(int node, List<List<Integer>> adj, boolean[] seen) {\n    seen[node] = true;\n    for (int next : adj.get(node)) {\n        if (!seen[next]) {\n            dfs(next, adj, seen);\n        }\n    }\n}",
