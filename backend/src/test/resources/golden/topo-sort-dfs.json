  "code" : "public int[] topoSort(int v, List<List<Integer>> adj) {\n    boolean[] vis = new boolean[v];\n    Deque<Integer> stack = new ArrayDeque<>();\n    for (int i = 0; i < v; i++) {\n        if (!vis[i]) {\n            dfs(i, adj, vis, stack);\n        }\n    }\n    int[] order = new int[v];\n    int idx = 0;\n    while (!stack.isEmpty()) {\n        order[idx++] = stack.pop();\n    }\n    return order;\n}\n\nprivate void dfs(int node, List<List<Integer>> adj, boolean[] vis, Deque<Integer> stack) {\n    vis[node] = true;\n    for (int next : adj.get(node)) {\n        if (!vis[next]) {\n            dfs(next, adj, vis, stack);\n        }\n    }\n    stack.push(node);\n}",
