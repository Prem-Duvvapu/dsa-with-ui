  "code" : "public int lengthOfLongestSubstring(String s) {\n    int[] lastSeen = new int[256];\n    Arrays.fill(lastSeen, -1);\n    int left = 0, maxLen = 0;\n\n    for (int right = 0; right < s.length(); right++) {\n        char c = s.charAt(right);\n        if (lastSeen[c] >= left) {\n            left = lastSeen[c] + 1;\n        }\n        lastSeen[c] = right;\n        maxLen = Math.max(maxLen, right - left + 1);\n    }\n    return maxLen;\n}",
