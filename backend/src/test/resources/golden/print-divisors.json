  "code" : "public List<Integer> getDivisors(int n) {\n    List<Integer> divisors = new ArrayList<>();\n    for (int i = 1; i * i <= n; i++) {\n        if (n % i == 0) {\n            divisors.add(i);\n            if ((n / i) != i) {\n                divisors.add(n / i);\n            }\n        }\n    }\n    Collections.sort(divisors);\n    return divisors;\n}",
