  "code" : "class Solution {\n    public String longestCommonPrefix(String[] strs) {\n        int n=strs.length;\n        String res=strs[0];\n\n        for (int i=1;i<n;i++) {\n            int j=0; //res pointer\n            int k=0; //strs[i] pointer\n\n            while (j<res.length() && k<strs[i].length()) {\n                if (res.charAt(j)!=strs[i].charAt(k)) {\n                    if (j==0)\n                        return \"\";\n\n                    res=res.substring(0,j);\n                    break;\n                }\n\n                j++;\n                k++;\n            }\n\n            if (k<res.length())\n                res=res.substring(0,k);\n\n        }\n\n        return res;\n    }\n}",
