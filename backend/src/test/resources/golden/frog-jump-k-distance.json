  "code" : "public int frogJumpK(int n, int k, int[] heights) {\n    int[] energy = new int[n];\n    energy[0] = 0;\n    for (int i = 1; i < n; i++) {\n        int best = Integer.MAX_VALUE;\n        for (int j = i - 1; j >= Math.max(0, i - k); j--) {\n            int cost = energy[j] + Math.abs(heights[i] - heights[j]);\n            best = Math.min(best, cost);\n        }\n        energy[i] = best;\n    }\n    return energy[n - 1];\n}",
