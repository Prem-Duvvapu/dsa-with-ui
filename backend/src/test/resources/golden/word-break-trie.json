  "code" : "public boolean wordBreak(String s, List<String> wordDict) {\n    Trie trie = new Trie();\n    for (String w : wordDict) {\n        trie.insert(w);\n    }\n\n    int n = s.length();\n    boolean[] dp = new boolean[n + 1];\n    dp[0] = true;\n\n    for (int i = 0; i < n; i++) {\n        if (!dp[i]) {\n            continue;\n        }\n        Node curr = trie.root;\n        for (int j = i; j < n; j++) {\n            char ch = s.charAt(j);\n            if (!curr.containsKey(ch)) {\n                break;\n            }\n            curr = curr.get(ch);\n            if (curr.isEnd()) {\n                dp[j + 1] = true;\n            } else {\n            }\n        }\n    }\n    return dp[n];\n}",
