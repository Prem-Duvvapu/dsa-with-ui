  "code" : "public TreeNode inorderSuccessor(TreeNode root, int target) {\n    TreeNode node = root;\n    while (node != null) {\n        if (node.val == target) break;\n        node = target < node.val ? node.left : node.right;\n    }\n    if (node == null) return null;\n\n    if (node.right != null) {\n        TreeNode curr = node.right;\n        while (curr.left != null) {\n            curr = curr.left;\n        }\n        return curr;\n    }\n\n    TreeNode successor = null;\n    TreeNode curr = root;\n    while (curr != null && curr.val != target) {\n        if (target < curr.val) {\n            successor = curr;      // a left turn passes a larger value\n            curr = curr.left;\n        } else {\n            curr = curr.right;     // a right turn passes a smaller one\n        }\n    }\n    return successor;\n}",
