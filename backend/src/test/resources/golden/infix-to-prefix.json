  "code" : "public String toPrefix(String s) {\n    String flipped = reverseAndSwapBrackets(s);\n    StringBuilder out = new StringBuilder();\n    Deque<Character> ops = new ArrayDeque<>();\n    for (char c : flipped.toCharArray()) {\n        if (isOperand(c)) {\n            out.append(c);\n        } else if (c == '(') {\n            ops.push(c);\n        } else if (c == ')') {\n            while (ops.peek() != '(') {\n                out.append(ops.pop());\n            }\n            ops.pop();\n        } else {\n            // Reversed: equal precedence must NOT pop, except for ^.\n            while (!ops.isEmpty() && ops.peek() != '('\n                    && bindsReversed(ops.peek(), c)) {\n                out.append(ops.pop());\n            }\n            ops.push(c);\n        }\n    }\n    while (!ops.isEmpty()) {\n        out.append(ops.pop());\n    }\n    String prefix = out.reverse().toString();\n    return prefix;\n}",
